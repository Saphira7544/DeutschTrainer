{
  "word_order": [
    {"t":"c","s":"Morgen ___ ich nach Bern.","o":["fahre","ich fahre","fahren"],"a":"fahre","e":"After a time expression in position 1, the verb comes next and the subject follows it."},
    {"t":"c","s":"___ du heute Abend Zeit?","o":["Hast","Du hast","Hat"],"a":"Hast","e":"Yes/no questions start with the conjugated verb."},
    {"t":"c","s":"Am Wochenende ___ wir oft Freunde.","o":["treffen","wir treffen","trefft"],"a":"treffen","e":"Verb in position 2, subject right after it."},
    {"t":"c","s":"Was ___ du am Samstag?","o":["machst","du machst","macht"],"a":"machst","e":"W-question: W-word, then the verb, then the subject."},
    {"t":"c","s":"Im Sommer ___ es in Zürich oft heiß.","o":["ist","es ist","sind"],"a":"ist","e":"The verb stays in position 2 even when the sentence starts with a time phrase."},
    {"t":"c","s":"Wann ___ der Zug?","o":["kommt","der Zug kommt","kommen"],"a":"kommt","e":"W-word + verb + subject."},
    {"t":"c","s":"Heute ___ meine Schwester Geburtstag.","o":["hat","meine Schwester hat","haben"],"a":"hat","e":"Verb in position 2 after 'Heute'."},
    {"t":"c","s":"___ Sie Deutsch?","o":["Sprechen","Sie sprechen","Spricht"],"a":"Sprechen","e":"Yes/no question: the verb comes first."},
    {"t":"g","s":"Nach der Arbeit ___ ich einkaufen.","h":"(gehen)","a":["gehe"],"e":"Position 2 after 'Nach der Arbeit', then the subject."},
    {"t":"g","s":"Wie lange ___ du schon in der Schweiz?","h":"(wohnen)","a":["wohnst"],"e":"W-question: verb right after the question word."},
    {"t":"g","s":"___ ihr morgen mit?","h":"(mitkommen)","a":["Kommt"],"e":"Yes/no question with ihr: Kommt ihr ...? The prefix 'mit' goes to the end."},
    {"t":"g","s":"Jeden Morgen ___ Lisa einen Kaffee.","h":"(trinken)","a":["trinkt"],"e":"Verb in position 2, subject after it."},
    {"t":"g","s":"In der Schweiz ___ man vier Sprachen.","h":"(sprechen)","a":["spricht"],"e":"man takes the er/sie/es form; sprechen → spricht."},
    {"t":"r","i":"Start the sentence with 'Morgen'.","s":"Ich arbeite morgen im Homeoffice.","a":["Morgen arbeite ich im Homeoffice."],"e":"The verb stays in position 2; the subject moves behind it."},
    {"t":"r","i":"Start the sentence with 'Am Abend'.","s":"Wir kochen am Abend zusammen.","a":["Am Abend kochen wir zusammen."],"e":"Position 1: Am Abend, position 2: the verb."},
    {"t":"r","i":"Make a yes/no question.","s":"Du hast heute Zeit.","a":["Hast du heute Zeit?"],"e":"Yes/no questions start with the verb."},
    {"t":"r","i":"Ask about the place with 'Wo'.","s":"Sie wohnt in Basel.","a":["Wo wohnt sie?"],"e":"W-word, verb, subject."},
    {"t":"r","i":"Ask about the time with 'Wann'.","s":"Der Kurs beginnt um 18 Uhr.","a":["Wann beginnt der Kurs?"],"e":"W-word, verb, subject."},
    {"t":"r","i":"Start the sentence with 'Leider'.","s":"Ich habe keine Zeit.","a":["Leider habe ich keine Zeit."],"e":"Leider takes position 1, so the verb comes next."},
    {"t":"r","i":"Start the sentence with 'Im Winter'.","s":"Wir fahren im Winter in die Berge.","a":["Im Winter fahren wir in die Berge."],"e":"Verb in position 2 after the time phrase."}
  ],
  "negation": [
    {"t":"c","s":"Ich habe ___ Auto.","o":["kein","nicht","keine"],"a":"kein","e":"Nouns with ein/no article are negated with kein; das Auto → kein Auto."},
    {"t":"c","s":"Das ist ___ mein Handy.","o":["nicht","kein","keine"],"a":"nicht","e":"Before a possessive (mein, dein ...) use nicht."},
    {"t":"c","s":"Er trinkt ___ Kaffee.","o":["keinen","nicht","kein"],"a":"keinen","e":"der Kaffee, accusative, no article → keinen Kaffee."},
    {"t":"c","s":"Ich komme heute ___.","o":["nicht","kein","keine"],"a":"nicht","e":"To negate a verb, use nicht."},
    {"t":"c","s":"Wir haben ___ Kinder.","o":["keine","kein","nicht"],"a":"keine","e":"Plural nouns: keine."},
    {"t":"c","s":"Das Essen ist ___ gut.","o":["nicht","kein","keine"],"a":"nicht","e":"Adjectives are negated with nicht."},
    {"t":"c","s":"Sie hat heute ___ Zeit.","o":["keine","kein","nicht"],"a":"keine","e":"die Zeit, no article → keine Zeit."},
    {"t":"c","s":"Ich finde den Schlüssel ___.","o":["nicht","keinen","kein"],"a":"nicht","e":"With a definite article (den Schlüssel) use nicht, usually at the end."},
    {"t":"g","s":"Hast du einen Bruder? – Nein, ich habe ___ Bruder.","h":"(kein)","a":["keinen"],"e":"der Bruder, accusative after haben → keinen."},
    {"t":"g","s":"Ist das eine Katze? – Nein, das ist ___ Katze, das ist ein Hund.","h":"(kein)","a":["keine"],"e":"die Katze → keine Katze."},
    {"t":"g","s":"Ich verstehe das ___.","h":"(nicht / kein)","a":["nicht"],"e":"Negating the verb: nicht at the end."},
    {"t":"g","s":"Es gibt hier ___ Supermarkt.","h":"(kein)","a":["keinen"],"e":"es gibt + accusative; der Supermarkt → keinen."},
    {"t":"g","s":"Ich brauche ___ Hilfe, danke.","h":"(kein)","a":["keine"],"e":"die Hilfe → keine Hilfe."},
    {"t":"g","s":"Peter arbeitet am Montag ___.","h":"(nicht / kein)","a":["nicht"],"e":"Negating the whole action: nicht at the end."},
    {"t":"r","i":"Answer with 'Nein' and kein.","s":"Hast du ein Fahrrad?","a":["Nein, ich habe kein Fahrrad."],"e":"das Fahrrad → kein Fahrrad."},
    {"t":"r","i":"Negate the sentence.","s":"Ich habe Hunger.","a":["Ich habe keinen Hunger."],"e":"der Hunger, no article → keinen Hunger."},
    {"t":"r","i":"Negate the sentence.","s":"Wir fahren morgen nach Genf.","a":["Wir fahren morgen nicht nach Genf."],"e":"nicht goes before the direction (nach Genf)."},
    {"t":"r","i":"Negate the sentence.","s":"Das ist meine Tasche.","a":["Das ist nicht meine Tasche."],"e":"Before a possessive: nicht."}
  ],
  "modal_verbs": [
    {"t":"c","s":"Ich ___ heute nicht kommen, ich bin krank.","o":["kann","könne","kannst"],"a":"kann","e":"können: ich kann (no ending in ich-form)."},
    {"t":"c","s":"Du ___ mehr Wasser trinken.","o":["sollst","sollt","soll"],"a":"sollst","e":"sollen: du sollst."},
    {"t":"c","s":"Hier ___ man nicht rauchen.","o":["darf","dürft","darfst"],"a":"darf","e":"dürfen: man darf."},
    {"t":"c","s":"Wir ___ morgen früh aufstehen.","o":["müssen","muss","müsst"],"a":"müssen","e":"müssen: wir müssen."},
    {"t":"c","s":"___ du mir helfen?","o":["Kannst","Kann","Könnt"],"a":"Kannst","e":"können: du kannst."},
    {"t":"c","s":"Mein Sohn ___ Pilot werden.","o":["will","wollt","willst"],"a":"will","e":"wollen: er will."},
    {"t":"c","s":"Ich ___ einen Kaffee, bitte.","o":["möchte","möchtet","möchten"],"a":"möchte","e":"möchten: ich möchte."},
    {"t":"c","s":"Ihr ___ hier nicht parken.","o":["dürft","darf","dürfen"],"a":"dürft","e":"dürfen: ihr dürft."},
    {"t":"g","s":"Er ___ sehr gut kochen.","h":"(können)","a":["kann"],"e":"er kann – same as the ich-form."},
    {"t":"g","s":"___ ich das Fenster öffnen?","h":"(dürfen)","a":["Darf"],"e":"ich darf."},
    {"t":"g","s":"Sie ___ heute länger arbeiten.","h":"(müssen; sie = she)","a":["muss"],"e":"sie muss."},
    {"t":"g","s":"Was ___ ihr am Wochenende machen?","h":"(wollen)","a":["wollt"],"e":"ihr wollt."},
    {"t":"g","s":"Du ___ nicht so viel arbeiten.","h":"(sollen)","a":["sollst"],"e":"du sollst."},
    {"t":"g","s":"Wir ___ ins Kino gehen. Kommst du mit?","h":"(möchten)","a":["möchten"],"e":"wir möchten."},
    {"t":"r","i":"Add the modal verb 'müssen'.","s":"Ich arbeite am Samstag.","a":["Ich muss am Samstag arbeiten."],"e":"Modal verb in position 2, infinitive at the end."},
    {"t":"r","i":"Add 'können'.","s":"Sprichst du Französisch?","a":["Kannst du Französisch sprechen?"],"e":"Kannst in position 1 of the question, sprechen at the end."},
    {"t":"r","i":"Add 'wollen'.","s":"Wir kaufen eine neue Wohnung.","a":["Wir wollen eine neue Wohnung kaufen."],"e":"The infinitive goes to the end."},
    {"t":"r","i":"Add 'dürfen'.","s":"Man fotografiert hier nicht.","a":["Man darf hier nicht fotografieren."],"e":"darf in position 2, fotografieren at the end."},
    {"t":"r","i":"Add 'möchten'.","s":"Ich bestelle eine Pizza.","a":["Ich möchte eine Pizza bestellen."],"e":"möchte + infinitive at the end."},
    {"t":"r","i":"Add 'sollen'.","s":"Er bleibt im Bett.","a":["Er soll im Bett bleiben."],"e":"soll in position 2, bleiben at the end."}
  ],
  "separable_verbs": [
    {"t":"c","s":"Wann ___ der Film an?","o":["fängt","anfängt","fangt"],"a":"fängt","e":"anfangen: the prefix 'an' goes to the end; er fängt."},
    {"t":"c","s":"Ich rufe dich später ___.","o":["an","auf","mit"],"a":"an","e":"anrufen → ich rufe ... an."},
    {"t":"c","s":"Kommst du heute Abend ___?","o":["mit","an","ein"],"a":"mit","e":"mitkommen → Kommst du ... mit?"},
    {"t":"c","s":"Wir kaufen im Supermarkt ___.","o":["ein","an","auf"],"a":"ein","e":"einkaufen → wir kaufen ... ein."},
    {"t":"c","s":"Ich möchte heute Abend ___.","o":["fernsehen","sehe fern","fern sehen"],"a":"fernsehen","e":"With a modal verb the separable verb stays together at the end."},
    {"t":"c","s":"Er ___ jeden Tag um 7 Uhr auf.","o":["steht","aufsteht","stehen"],"a":"steht","e":"aufstehen → er steht ... auf."},
    {"t":"c","s":"Kannst du bitte das Fenster ___?","o":["zumachen","machen zu","zu machen"],"a":"zumachen","e":"Infinitive after können: zumachen in one word."},
    {"t":"c","s":"Der Zug ___ um 9.15 Uhr ab.","o":["fährt","abfährt","fahrt"],"a":"fährt","e":"abfahren → der Zug fährt ... ab."},
    {"t":"g","s":"Ich ___ meine Mutter jeden Sonntag an.","h":"(anrufen)","a":["rufe"],"e":"ich rufe ... an."},
    {"t":"g","s":"Wann kommst du morgen ___?","h":"(zurückkommen)","a":["zurück"],"e":"The prefix goes to the end of the sentence."},
    {"t":"g","s":"Bitte ___ Sie hier aus.","h":"(aussteigen)","a":["steigen"],"e":"aussteigen → Steigen Sie ... aus."},
    {"t":"g","s":"Ich muss heute noch ___.","h":"(einkaufen)","a":["einkaufen"],"e":"After müssen: the infinitive in one piece."},
    {"t":"g","s":"Das Konzert ___ um 20 Uhr an.","h":"(anfangen)","a":["fängt"],"e":"anfangen: es fängt ... an (a → ä)."},
    {"t":"g","s":"Wir ___ am Freitag unsere Freunde ein.","h":"(einladen)","a":["laden"],"e":"einladen → wir laden ... ein."},
    {"t":"r","i":"Make a sentence: ich / aufstehen / um 6 Uhr","s":"ich / aufstehen / um 6 Uhr","a":["Ich stehe um 6 Uhr auf.","Um 6 Uhr stehe ich auf."],"e":"Verb in position 2, prefix at the end."},
    {"t":"r","i":"Make a sentence: der Zug / ankommen / um 10 Uhr","s":"der Zug / ankommen / um 10 Uhr","a":["Der Zug kommt um 10 Uhr an.","Um 10 Uhr kommt der Zug an."],"e":"kommt in position 2, an at the end."},
    {"t":"r","i":"Add 'möchte'.","s":"Ich rufe meinen Chef an.","a":["Ich möchte meinen Chef anrufen."],"e":"With a modal verb: anrufen together at the end."},
    {"t":"r","i":"Add 'muss'.","s":"Er räumt sein Zimmer auf.","a":["Er muss sein Zimmer aufräumen."],"e":"aufräumen together at the end."},
    {"t":"r","i":"Make a sentence: wir / fernsehen / am Abend","s":"wir / fernsehen / am Abend","a":["Wir sehen am Abend fern.","Am Abend sehen wir fern."],"e":"sehen in position 2, fern at the end."},
    {"t":"r","i":"Make a question with 'du': mitkommen / ins Kino","s":"mitkommen / ins Kino","a":["Kommst du mit ins Kino?","Kommst du ins Kino mit?"],"e":"Verb first, mit at the end (or before ins Kino in speech)."}
  ],
  "imperative": [
    {"t":"c","s":"(du) ___ bitte das Fenster!","o":["Öffne","Öffnest","Öffnen"],"a":"Öffne","e":"du-imperative: stem (+ e for stems ending in -n after a consonant): öffne."},
    {"t":"c","s":"(ihr) ___ leise, die Kinder schlafen!","o":["Seid","Sind","Sei"],"a":"Seid","e":"sein: Sei! (du), Seid! (ihr), Seien Sie! (Sie)."},
    {"t":"c","s":"(Sie) ___ bitte Platz!","o":["Nehmen Sie","Nimm","Nehmt"],"a":"Nehmen Sie","e":"Sie-imperative: infinitive + Sie."},
    {"t":"c","s":"(du) ___ mir bitte das Salz!","o":["Gib","Gibst","Gebe"],"a":"Gib","e":"geben: du gibst → Gib! (e → i stays)."},
    {"t":"c","s":"(du) ___ nicht so schnell!","o":["Fahr","Fährst","Fähr"],"a":"Fahr","e":"a → ä verbs lose the umlaut in the imperative: Fahr!"},
    {"t":"c","s":"(du) ___ keine Angst!","o":["Hab","Hast","Habt"],"a":"Hab","e":"haben: Hab! (or Habe!)."},
    {"t":"c","s":"(du) ___ mich morgen an!","o":["Ruf","Rufst","Anrufen"],"a":"Ruf","e":"anrufen: Ruf ... an!"},
    {"t":"c","s":"(du) ___ bitte pünktlich!","o":["Sei","Bist","Seid"],"a":"Sei","e":"sein: du → Sei!"},
    {"t":"g","s":"(du) ___ das Buch!","h":"(lesen)","a":["Lies"],"e":"lesen: du liest → Lies!"},
    {"t":"g","s":"(ihr) ___ euch die Hände!","h":"(waschen)","a":["Wascht"],"e":"ihr-imperative = ihr-form without ihr: Wascht!"},
    {"t":"g","s":"(du) ___ bitte langsamer!","h":"(sprechen)","a":["Sprich"],"e":"sprechen: du sprichst → Sprich!"},
    {"t":"g","s":"(Sie) ___ bitte hier!","h":"(warten)","a":["Warten Sie"],"e":"Sie-imperative: Warten Sie!"},
    {"t":"g","s":"(du) ___ doch mit!","h":"(mitkommen)","a":["Komm","Komme"],"e":"Komm mit! – the prefix goes to the end."},
    {"t":"g","s":"(du) ___ das Licht aus!","h":"(ausmachen)","a":["Mach","Mache"],"e":"Mach ... aus!"},
    {"t":"r","i":"Make it an imperative (du).","s":"Du hilfst mir.","a":["Hilf mir!"],"e":"helfen: du hilfst → Hilf!"},
    {"t":"r","i":"Make it an imperative (Sie).","s":"Sie füllen das Formular aus.","a":["Füllen Sie das Formular aus!","Füllen Sie bitte das Formular aus!"],"e":"Infinitive stem + Sie, prefix at the end."},
    {"t":"r","i":"Make it an imperative (ihr).","s":"Ihr kommt pünktlich.","a":["Kommt pünktlich!"],"e":"ihr-form without the pronoun."},
    {"t":"r","i":"Make it an imperative (du).","s":"Du isst nicht so viel Schokolade.","a":["Iss nicht so viel Schokolade!"],"e":"essen: du isst → Iss!"}
  ],
  "accusative": [
    {"t":"c","s":"Ich brauche ___ neuen Laptop.","o":["einen","ein","einem"],"a":"einen","e":"der Laptop, accusative → einen."},
    {"t":"c","s":"Siehst du ___ Mann dort?","o":["den","der","dem"],"a":"den","e":"Direct object, masculine → den."},
    {"t":"c","s":"Das Geschenk ist für ___.","o":["dich","dir","du"],"a":"dich","e":"für + accusative: dich."},
    {"t":"c","s":"Wir besuchen ___ morgen. (Paul)","o":["ihn","ihm","er"],"a":"ihn","e":"besuchen + accusative: er → ihn."},
    {"t":"c","s":"Ich kaufe ___ Brot.","o":["ein","einen","eine"],"a":"ein","e":"das Brot: neuter doesn't change in the accusative."},
    {"t":"c","s":"Er geht ohne ___ Jacke raus.","o":["seine","seiner","seinen"],"a":"seine","e":"ohne + accusative; die Jacke → seine."},
    {"t":"c","s":"Kennst du ___ Film?","o":["den","dem","der"],"a":"den","e":"der Film → den Film."},
    {"t":"c","s":"Wir fahren durch ___ Tunnel.","o":["den","dem","der"],"a":"den","e":"durch + accusative; der Tunnel → den."},
    {"t":"g","s":"Hast du ___ Schlüssel gesehen?","h":"(der)","a":["den"],"e":"Direct object, masculine: den."},
    {"t":"g","s":"Ich nehme ___ Salat.","h":"(ein)","a":["einen"],"e":"der Salat → einen Salat."},
    {"t":"g","s":"Ruf ___ bitte morgen an!","h":"(ich)","a":["mich"],"e":"anrufen + accusative: mich."},
    {"t":"g","s":"Ich liebe ___.","h":"(du)","a":["dich"],"e":"lieben + accusative: dich."},
    {"t":"g","s":"Wir haben ___ Hund.","h":"(kein)","a":["keinen"],"e":"der Hund → keinen Hund."},
    {"t":"g","s":"Der Kuchen ist für ___ Großvater.","h":"(mein)","a":["meinen"],"e":"für + accusative, masculine: meinen."},
    {"t":"g","s":"Was machst du gegen ___ Husten?","h":"(der)","a":["den"],"e":"gegen + accusative: den."},
    {"t":"r","i":"Replace the object with a pronoun.","s":"Ich sehe den Bus.","a":["Ich sehe ihn."],"e":"der Bus → ihn."},
    {"t":"r","i":"Replace the object with a pronoun.","s":"Wir besuchen unsere Freunde.","a":["Wir besuchen sie."],"e":"Plural → sie."},
    {"t":"r","i":"Replace the object with a pronoun.","s":"Kaufst du das Auto?","a":["Kaufst du es?"],"e":"das Auto → es."},
    {"t":"r","i":"Make a sentence: ich / suchen / mein Schlüssel","s":"ich / suchen / mein Schlüssel","a":["Ich suche meinen Schlüssel."],"e":"der Schlüssel, accusative → meinen."},
    {"t":"r","i":"Make a sentence: er / haben / ein Bruder","s":"er / haben / ein Bruder","a":["Er hat einen Bruder."],"e":"haben + accusative: einen Bruder."}
  ],
  "dative_basics": [
    {"t":"c","s":"Ich fahre mit ___ Zug.","o":["dem","den","der"],"a":"dem","e":"mit + dative; der Zug → dem Zug."},
    {"t":"c","s":"Sie wohnt bei ___ Eltern.","o":["ihren","ihre","ihrer"],"a":"ihren","e":"bei + dative plural: ihren (+ n on the noun)."},
    {"t":"c","s":"Ich komme gerade von ___ Arbeit.","o":["der","die","dem"],"a":"der","e":"von + dative; die Arbeit → der Arbeit."},
    {"t":"c","s":"Kommst du heute zu ___?","o":["mir","mich","ich"],"a":"mir","e":"zu + dative: mir."},
    {"t":"c","s":"Nach ___ Kurs gehen wir essen.","o":["dem","den","der"],"a":"dem","e":"nach + dative; der Kurs → dem Kurs."},
    {"t":"c","s":"Er wohnt seit ___ Jahr in Luzern.","o":["einem","ein","einen"],"a":"einem","e":"seit + dative; das Jahr → einem Jahr."},
    {"t":"c","s":"Ich gehe ___ Arzt.","o":["zum","zur","zu"],"a":"zum","e":"zu + dem = zum (der Arzt)."},
    {"t":"c","s":"Sie kommt aus ___ Schweiz.","o":["der","die","dem"],"a":"der","e":"aus + dative; die Schweiz → aus der Schweiz."},
    {"t":"g","s":"Ich spreche oft mit ___ Kollegen.","h":"(meine, Plural)","a":["meinen"],"e":"mit + dative plural: meinen Kollegen."},
    {"t":"g","s":"Wir treffen uns ___ Bahnhof.","h":"(bei + dem)","a":["beim"],"e":"bei + dem = beim."},
    {"t":"g","s":"Ich gehe heute ___ Post.","h":"(zu + der)","a":["zur"],"e":"zu + der = zur."},
    {"t":"g","s":"Das Paket ist von ___ Schwester.","h":"(meine)","a":["meiner"],"e":"von + dative, feminine: meiner."},
    {"t":"g","s":"Kannst du mit ___ sprechen?","h":"(er)","a":["ihm"],"e":"mit + dative: er → ihm."},
    {"t":"g","s":"Ich habe ein Geschenk von ___ bekommen.","h":"(sie, Plural)","a":["ihnen"],"e":"von + dative: sie (plural) → ihnen."},
    {"t":"g","s":"Er fährt mit ___ Fahrrad zur Arbeit.","h":"(das)","a":["dem"],"e":"mit + dative; das Fahrrad → dem."},
    {"t":"g","s":"Nach ___ Arbeit gehe ich ins Fitnessstudio.","h":"(die)","a":["der"],"e":"nach + dative; die Arbeit → der Arbeit."},
    {"t":"r","i":"Make a sentence: ich / fahren / mit / der Bus","s":"ich / fahren / mit / der Bus","a":["Ich fahre mit dem Bus."],"e":"mit + dative: dem Bus."},
    {"t":"r","i":"Make a sentence: wir / wohnen / bei / unsere Großeltern","s":"wir / wohnen / bei / unsere Großeltern","a":["Wir wohnen bei unseren Großeltern."],"e":"Dative plural: unseren Großeltern."},
    {"t":"r","i":"Make a sentence: er / gehen / zu / die Apotheke","s":"er / gehen / zu / die Apotheke","a":["Er geht zur Apotheke."],"e":"zu + der = zur."},
    {"t":"r","i":"Make a sentence: seit / ein Monat / lernen / sie / Deutsch","s":"seit / ein Monat / lernen / sie / Deutsch","a":["Seit einem Monat lernt sie Deutsch.","Sie lernt seit einem Monat Deutsch."],"e":"seit + dative: einem Monat."}
  ],
  "possessives": [
    {"t":"c","s":"(ich) Das ist ___ Bruder.","o":["mein","meine","meinen"],"a":"mein","e":"der Bruder, nominative → mein."},
    {"t":"c","s":"(sie, she) Anna ruft ___ Mutter an.","o":["ihre","seine","ihren"],"a":"ihre","e":"Her = ihr; die Mutter, accusative → ihre."},
    {"t":"c","s":"(er) Tom besucht ___ Eltern.","o":["seine","ihre","seinen"],"a":"seine","e":"His = sein; plural accusative → seine."},
    {"t":"c","s":"(wir) ___ Wohnung ist klein.","o":["Unsere","Unser","Unseren"],"a":"Unsere","e":"die Wohnung → unsere."},
    {"t":"c","s":"(du) Ist das ___ Handy?","o":["dein","deine","deinen"],"a":"dein","e":"das Handy → dein."},
    {"t":"c","s":"(ihr) Wo ist ___ Auto?","o":["euer","eure","euren"],"a":"euer","e":"das Auto, nominative → euer."},
    {"t":"c","s":"(Sie) Wie ist ___ Name?","o":["Ihr","Ihre","Sein"],"a":"Ihr","e":"Formal 'your' = Ihr; der Name → Ihr."},
    {"t":"c","s":"(ich) Ich fahre mit ___ Freundin nach Bern.","o":["meiner","meine","meinem"],"a":"meiner","e":"mit + dative, feminine: meiner."},
    {"t":"g","s":"(ich) Ich suche ___ Brille.","h":"(mein)","a":["meine"],"e":"die Brille, accusative → meine."},
    {"t":"g","s":"(er) Er hat ___ Schlüssel vergessen.","h":"(sein; der Schlüssel)","a":["seinen"],"e":"Masculine accusative → seinen."},
    {"t":"g","s":"(sie, they) Die Kinder spielen mit ___ Hund.","h":"(ihr)","a":["ihrem"],"e":"mit + dative, masculine → ihrem."},
    {"t":"g","s":"(wir) Wir wohnen bei ___ Tante.","h":"(unser)","a":["unserer"],"e":"bei + dative, feminine → unserer."},
    {"t":"g","s":"(du) Hast du ___ Pass dabei?","h":"(dein; der Pass)","a":["deinen"],"e":"Masculine accusative → deinen."},
    {"t":"g","s":"(ihr) Ist das ___ Katze?","h":"(euer)","a":["eure"],"e":"euer loses the e before endings: eure."},
    {"t":"r","i":"Use a possessive instead of 'von Maria'.","s":"Das ist das Auto von Maria.","a":["Das ist ihr Auto."],"e":"Maria → ihr."},
    {"t":"r","i":"Use a possessive instead of 'von Paul'.","s":"Ich kenne den Bruder von Paul.","a":["Ich kenne seinen Bruder."],"e":"Paul → sein; der Bruder, accusative → seinen."},
    {"t":"r","i":"Use a possessive instead of 'von uns'.","s":"Das ist der Garten von uns.","a":["Das ist unser Garten."],"e":"uns → unser."},
