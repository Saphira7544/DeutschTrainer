{
  "perfekt": [
    {"t":"c","s":"Gestern ___ ich nach Luzern gefahren.","o":["bin","habe","war"],"a":"bin","e":"fahren = movement → sein."},
    {"t":"c","s":"Wir ___ am Abend Pizza gegessen.","o":["haben","sind","hatten"],"a":"haben","e":"Most verbs with an object take haben."},
    {"t":"c","s":"Er ist um 6 Uhr ___.","o":["aufgestanden","aufgestehen","aufgesteht"],"a":"aufgestanden","e":"Separable verbs: ge between prefix and stem: auf-ge-standen."},
    {"t":"c","s":"Hast du die Aufgabe ___?","o":["verstanden","geverstanden","verstehen"],"a":"verstanden","e":"Inseparable prefixes (ver-, be-, er-, ent-) take no ge-."},
    {"t":"c","s":"Sie hat in Bern Medizin ___.","o":["studiert","gestudiert","studieren"],"a":"studiert","e":"-ieren verbs have no ge-: studiert."},
    {"t":"c","s":"Was ___ passiert?","o":["ist","hat","wird"],"a":"ist","e":"passieren takes sein."},
    {"t":"c","s":"Ich habe meine Freundin ___.","o":["angerufen","angeruft","geanrufen"],"a":"angerufen","e":"anrufen → angerufen (irregular, separable)."},
    {"t":"c","s":"Wie lange ___ ihr in Italien geblieben?","o":["seid","habt","sind"],"a":"seid","e":"bleiben takes sein."},
    {"t":"g","s":"Ich habe gestern lange ___.","h":"(schlafen)","a":["geschlafen"],"e":"schlafen → geschlafen."},
    {"t":"g","s":"Wir sind ins Kino ___.","h":"(gehen)","a":["gegangen"],"e":"gehen → gegangen, with sein."},
    {"t":"g","s":"Hast du schon ___?","h":"(einkaufen)","a":["eingekauft"],"e":"einkaufen → eingekauft."},
    {"t":"g","s":"Der Film hat um 20 Uhr ___.","h":"(beginnen)","a":["begonnen"],"e":"beginnen → begonnen (no ge-)."},
    {"t":"g","s":"Ich ___ letztes Jahr in Spanien gewesen.","h":"(sein)","a":["bin"],"e":"sein takes sein: ich bin gewesen."},
    {"t":"g","s":"Was hast du zum Geburtstag ___?","h":"(bekommen)","a":["bekommen"],"e":"bekommen → bekommen (be-, no ge-)."},
    {"t":"g","s":"Mein Sohn ist groß ___.","h":"(werden)","a":["geworden"],"e":"werden → geworden, with sein (change of state)."},
    {"t":"r","i":"Put the sentence into the Perfekt.","s":"Ich trinke einen Kaffee.","a":["Ich habe einen Kaffee getrunken."],"e":"haben + getrunken at the end."},
    {"t":"r","i":"Put the sentence into the Perfekt.","s":"Wir fliegen nach Lissabon.","a":["Wir sind nach Lissabon geflogen."],"e":"Movement: sein + geflogen."},
    {"t":"r","i":"Put the sentence into the Perfekt.","s":"Er bringt mir Blumen mit.","a":["Er hat mir Blumen mitgebracht."],"e":"mitbringen → mitgebracht."},
    {"t":"r","i":"Put the sentence into the Perfekt.","s":"Sie verkauft ihr Auto.","a":["Sie hat ihr Auto verkauft."],"e":"verkaufen → verkauft (no ge-)."},
    {"t":"r","i":"Put the sentence into the Perfekt.","s":"Der Zug kommt pünktlich an.","a":["Der Zug ist pünktlich angekommen."],"e":"ankommen → angekommen, with sein."}
  ],
  "praeteritum_basic": [
    {"t":"c","s":"Gestern ___ ich krank.","o":["war","bin","wäre"],"a":"war","e":"sein in Präteritum: ich war."},
    {"t":"c","s":"Wir ___ keine Zeit.","o":["hatten","haben","hätten"],"a":"hatten","e":"haben in Präteritum: wir hatten."},
    {"t":"c","s":"Als Kind ___ ich nicht schwimmen.","o":["konnte","kann","könnte"],"a":"konnte","e":"können: ich konnte."},
    {"t":"c","s":"Er ___ gestern lange arbeiten.","o":["musste","muss","müsste"],"a":"musste","e":"müssen: er musste (no umlaut in Präteritum)."},
    {"t":"c","s":"___ du am Wochenende zu Hause?","o":["Warst","Wart","War"],"a":"Warst","e":"sein: du warst."},
    {"t":"c","s":"Ihr ___ doch Urlaub, oder?","o":["hattet","hattest","hatten"],"a":"hattet","e":"haben: ihr hattet."},
    {"t":"c","s":"Wir ___ eigentlich ins Kino gehen, aber es war zu spät.","o":["wollten","wollen","willten"],"a":"wollten","e":"wollen: wir wollten."},
    {"t":"c","s":"Als Kinder ___ wir nicht lange fernsehen.","o":["durften","dürften","darften"],"a":"durften","e":"dürfen: wir durften (no umlaut)."},
    {"t":"g","s":"Das Wetter ___ super!","h":"(sein)","a":["war"],"e":"es war."},
    {"t":"g","s":"Ich ___ gestern Kopfschmerzen.","h":"(haben)","a":["hatte"],"e":"ich hatte."},
    {"t":"g","s":"Wo ___ ihr letzte Woche?","h":"(sein)","a":["wart"],"e":"ihr wart."},
    {"t":"g","s":"Sie ___ mich nicht anrufen, weil ihr Handy kaputt war.","h":"(können)","a":["konnte"],"e":"sie konnte."},
    {"t":"g","s":"Ich ___ dich fragen, ob du morgen Zeit hast.","h":"(wollen)","a":["wollte"],"e":"ich wollte."},
    {"t":"g","s":"Der Arzt hat gesagt, ich ___ viel trinken.","h":"(sollen)","a":["sollte"],"e":"ich sollte – reporting what someone told you."},
    {"t":"g","s":"Wir ___ um 5 Uhr aufstehen.","h":"(müssen)","a":["mussten"],"e":"wir mussten."},
    {"t":"r","i":"Put it into the Präteritum.","s":"Ich bin müde.","a":["Ich war müde."],"e":"bin → war."},
    {"t":"r","i":"Put it into the Präteritum.","s":"Wir haben ein Problem.","a":["Wir hatten ein Problem."],"e":"haben → hatten."},
    {"t":"r","i":"Put it into the Präteritum.","s":"Du kannst nicht kommen.","a":["Du konntest nicht kommen."],"e":"kannst → konntest."},
    {"t":"r","i":"Put it into the Präteritum.","s":"Sie muss zum Arzt gehen.","a":["Sie musste zum Arzt gehen."],"e":"muss → musste."},
    {"t":"r","i":"Put it into the Präteritum.","s":"Seid ihr im Urlaub?","a":["Wart ihr im Urlaub?"],"e":"seid → wart."}
  ],
  "dative_verbs": [
    {"t":"c","s":"Kannst du ___ helfen?","o":["mir","mich","ich"],"a":"mir","e":"helfen takes the dative: mir."},
    {"t":"c","s":"Das Kleid gefällt ___ sehr.","o":["ihr","sie","ihre"],"a":"ihr","e":"gefallen + dative: sie → ihr."},
    {"t":"c","s":"Wem gehört das Fahrrad? – Es gehört ___.","o":["ihm","ihn","er"],"a":"ihm","e":"gehören + dative: er → ihm."},
    {"t":"c","s":"Ich danke ___ für die Einladung.","o":["Ihnen","Sie","Ihr"],"a":"Ihnen","e":"danken + dative: Sie → Ihnen."},
    {"t":"c","s":"Schmeckt ___ das Essen?","o":["dir","dich","du"],"a":"dir","e":"schmecken + dative: dir."},
    {"t":"c","s":"Ich schenke ___ Bruder ein Buch.","o":["meinem","meinen","mein"],"a":"meinem","e":"Person = dative: meinem Bruder."},
    {"t":"c","s":"Passt ___ der Termin am Freitag?","o":["euch","ihr","eure"],"a":"euch","e":"passen + dative: ihr → euch."},
    {"t":"c","s":"Die Schuhe stehen ___ gut.","o":["dir","dich","deine"],"a":"dir","e":"jemandem stehen (to suit someone) + dative."},
    {"t":"g","s":"Ich gratuliere ___ zum Geburtstag!","h":"(du)","a":["dir"],"e":"gratulieren + dative."},
    {"t":"g","s":"Kannst du ___ Kollegin die Datei schicken?","h":"(die)","a":["der"],"e":"Person = dative; die Kollegin → der Kollegin."},
    {"t":"g","s":"Wie geht es ___?","h":"(Sie)","a":["Ihnen"],"e":"Wie geht es + dative."},
    {"t":"g","s":"Der Film hat ___ nicht gefallen.","h":"(wir)","a":["uns"],"e":"gefallen + dative: uns."},
    {"t":"g","s":"Antworte ___ bitte bald!","h":"(ich)","a":["mir"],"e":"antworten + dative."},
    {"t":"g","s":"Ich zeige ___ Kindern den Zoo.","h":"(die, Plural)","a":["den"],"e":"Dative plural: den Kindern."},
    {"t":"g","s":"Gib ___ bitte den Schlüssel!","h":"(er)","a":["ihm"],"e":"Person = dative: ihm."},
    {"t":"r","i":"Replace both objects with pronouns.","s":"Ich gebe dem Kellner das Geld.","a":["Ich gebe es ihm."],"e":"Two pronouns: accusative before dative (es ihm)."},
    {"t":"r","i":"Replace the person with a pronoun.","s":"Ich erkläre meiner Schwester die Aufgabe.","a":["Ich erkläre ihr die Aufgabe."],"e":"meiner Schwester (dative) → ihr."},
    {"t":"r","i":"Make a sentence: das Essen / schmecken / ich / gut","s":"das Essen / schmecken / ich / gut","a":["Das Essen schmeckt mir gut."],"e":"schmecken + dative: mir."},
    {"t":"r","i":"Make a sentence: die Jacke / gehören / mein Bruder","s":"die Jacke / gehören / mein Bruder","a":["Die Jacke gehört meinem Bruder."],"e":"gehören + dative: meinem Bruder."},
    {"t":"r","i":"Make a sentence: Basel / gefallen / wir / sehr","s":"Basel / gefallen / wir / sehr","a":["Basel gefällt uns sehr.","Uns gefällt Basel sehr."],"e":"gefallen + dative: uns."}
  ],
  "two_way_prepositions": [
    {"t":"c","s":"Das Buch liegt auf ___ Tisch.","o":["dem","den","der"],"a":"dem","e":"liegen = where (location) → dative."},
    {"t":"c","s":"Ich lege das Buch auf ___ Tisch.","o":["den","dem","der"],"a":"den","e":"legen = where to (direction) → accusative."},
    {"t":"c","s":"Wir gehen heute ___ Kino.","o":["ins","im","in"],"a":"ins","e":"Direction: in + das = ins."},
    {"t":"c","s":"Wir sind gerade ___ Kino.","o":["im","ins","in den"],"a":"im","e":"Location: in + dem = im."},
    {"t":"c","s":"Das Bild hängt an ___ Wand.","o":["der","die","dem"],"a":"der","e":"hängen (location) → dative: an der Wand."},
    {"t":"c","s":"Stell die Flasche bitte in ___ Kühlschrank.","o":["den","dem","der"],"a":"den","e":"stellen = direction → accusative."},
    {"t":"c","s":"Die Katze sitzt unter ___ Bett.","o":["dem","das","den"],"a":"dem","e":"sitzen = location → dative."},
    {"t":"c","s":"Er setzt sich neben ___ Freundin.","o":["seine","seiner","seinen"],"a":"seine","e":"sich setzen = direction → accusative."},
    {"t":"g","s":"Der Schlüssel liegt ___ Schreibtisch.","h":"(auf + dem)","a":["auf dem"],"e":"Location → dative."},
    {"t":"g","s":"Ich gehe jetzt in ___ Küche.","h":"(die)","a":["die"],"e":"Direction → accusative; feminine stays die."},
    {"t":"g","s":"Das Auto steht vor ___ Haus.","h":"(das)","a":["dem"],"e":"stehen = location → dative."},
    {"t":"g","s":"Häng die Jacke bitte an ___ Garderobe.","h":"(die)","a":["die"],"e":"Direction → accusative."},
    {"t":"g","s":"Zwischen ___ Fenstern steht ein Sofa.","h":"(die, Plural)","a":["den"],"e":"Location → dative plural: den Fenstern."},
    {"t":"g","s":"Ich habe die Milch auf den Tisch ___.","h":"(stellen / stehen)","a":["gestellt"],"e":"Direction (auf den Tisch) → stellen."},
    {"t":"g","s":"Die Milch ___ auf dem Tisch.","h":"(stellen / stehen)","a":["steht"],"e":"Location (auf dem Tisch) → stehen."},
    {"t":"r","i":"Answer: Wo ist die Brille? (in / die Tasche)","s":"Wo ist die Brille?","a":["Die Brille ist in der Tasche.","Sie ist in der Tasche.","In der Tasche."],"e":"wo → dative: in der Tasche."},
    {"t":"r","i":"Answer: Wohin fährst du? (in / die Stadt)","s":"Wohin fährst du?","a":["Ich fahre in die Stadt.","In die Stadt."],"e":"wohin → accusative: in die Stadt."},
    {"t":"r","i":"Make a sentence: ich / legen / das Handy / auf / das Sofa","s":"ich / legen / das Handy / auf / das Sofa","a":["Ich lege das Handy auf das Sofa.","Ich lege das Handy aufs Sofa."],"e":"legen = direction → accusative."},
    {"t":"r","i":"Make a sentence: das Handy / liegen / auf / das Sofa","s":"das Handy / liegen / auf / das Sofa","a":["Das Handy liegt auf dem Sofa."],"e":"liegen = location → dative."}
  ],
  "reflexive_verbs": [
    {"t":"c","s":"Ich freue ___ auf das Wochenende.","o":["mich","mir","sich"],"a":"mich","e":"sich freuen: ich freue mich."},
    {"t":"c","s":"Wir treffen ___ um 7 Uhr.","o":["uns","euch","sich"],"a":"uns","e":"wir → uns."},
    {"t":"c","s":"Ärgerst du ___ oft?","o":["dich","dir","sich"],"a":"dich","e":"du → dich."},
    {"t":"c","s":"Er rasiert ___ jeden Morgen.","o":["sich","ihn","ihm"],"a":"sich","e":"er/sie/es/Sie → sich."},
    {"t":"c","s":"Ich wasche ___ die Hände.","o":["mir","mich","sich"],"a":"mir","e":"With another object (die Hände) the reflexive pronoun is dative: mir."},
    {"t":"c","s":"Habt ihr ___ schon angemeldet?","o":["euch","uns","sich"],"a":"euch","e":"ihr → euch."},
    {"t":"c","s":"Kannst du ___ das vorstellen?","o":["dir","dich","sich"],"a":"dir","e":"sich etwas vorstellen: dative because 'das' is the object."},
    {"t":"c","s":"Die Kinder ziehen ___ an.","o":["sich","ihnen","sie"],"a":"sich","e":"sie (plural) → sich."},
    {"t":"g","s":"Ich muss ___ beeilen.","h":"(ich)","a":["mich"],"e":"sich beeilen: ich beeile mich."},
    {"t":"g","s":"Du putzt ___ die Zähne.","h":"(du)","a":["dir"],"e":"Second object (die Zähne) → dative reflexive: dir."},
    {"t":"g","s":"Interessierst du ___ für Fußball?","h":"(du)","a":["dich"],"e":"sich interessieren für: dich."},
    {"t":"g","s":"Wir haben ___ in Zürich kennengelernt.","h":"(wir)","a":["uns"],"e":"sich kennenlernen: uns."},
    {"t":"g","s":"Setzen Sie ___ bitte!","h":"(Sie)","a":["sich"],"e":"Sie → sich."},
    {"t":"g","s":"Ich kaufe ___ einen neuen Mantel.","h":"(ich)","a":["mir"],"e":"Dative 'for myself' with an accusative object: mir."},
    {"t":"g","s":"Er fühlt ___ heute nicht gut.","h":"(er)","a":["sich"],"e":"sich fühlen: er fühlt sich."},
    {"t":"r","i":"Change the subject to 'ich'.","s":"Er erholt sich im Urlaub.","a":["Ich erhole mich im Urlaub."],"e":"ich → mich."},
    {"t":"r","i":"Change the subject to 'wir'.","s":"Sie streiten sich oft.","a":["Wir streiten uns oft."],"e":"wir → uns."},
    {"t":"r","i":"Change the subject to 'du'.","s":"Ich kämme mir die Haare.","a":["Du kämmst dir die Haare."],"e":"Dative reflexive: dir."},
    {"t":"r","i":"Put it into the Perfekt.","s":"Ich verspäte mich.","a":["Ich habe mich verspätet."],"e":"Reflexive verbs take haben; the pronoun stays after the auxiliary."}
  ],
  "comparison": [
    {"t":"c","s":"Zürich ist ___ als Bern.","o":["größer","groß","am größten"],"a":"größer","e":"Comparative + als."},
    {"t":"c","s":"Mein Bruder ist so alt ___ ich.","o":["wie","als","dann"],"a":"wie","e":"Equality: so ... wie."},
    {"t":"c","s":"Im Winter ist es ___ als im Sommer.","o":["kälter","kalter","mehr kalt"],"a":"kälter","e":"Short adjectives often get an umlaut: kalt → kälter."},
    {"t":"c","s":"Ich trinke ___ Tee als Kaffee.","o":["lieber","gerner","mehr gern"],"a":"lieber","e":"gern → lieber → am liebsten."},
    {"t":"c","s":"Wer kocht in deiner Familie am ___?","o":["besten","gutsten","besser"],"a":"besten","e":"gut → besser → am besten."},
    {"t":"c","s":"Heute habe ich ___ Zeit als gestern.","o":["mehr","viel","meister"],"a":"mehr","e":"viel → mehr → am meisten."},
    {"t":"c","s":"Das ist der ___ Berg der Schweiz.","o":["höchste","höhere","hochste"],"a":"höchste","e":"hoch → höher → am höchsten; as an adjective: der höchste Berg."},
    {"t":"c","s":"Mein Handy ist nicht so teuer ___ deins.","o":["wie","als","wenn"],"a":"wie","e":"nicht so ... wie."},
    {"t":"g","s":"Der Zug ist ___ als der Bus.","h":"(schnell)","a":["schneller"],"e":"Comparative: -er."},
    {"t":"g","s":"Im Juli ist es am ___.","h":"(warm)","a":["wärmsten"],"e":"Superlative: am wärmsten (with umlaut)."},
    {"t":"g","s":"Meine Wohnung ist ___ als deine.","h":"(klein)","a":["kleiner"],"e":"klein → kleiner."},
    {"t":"g","s":"Am ___ esse ich Pasta.","h":"(gern)","a":["liebsten"],"e":"gern → lieber → am liebsten."},
    {"t":"g","s":"Deutsch ist ___ als Englisch.","h":"(schwer)","a":["schwerer"],"e":"schwer → schwerer."},
    {"t":"g","s":"Wer von euch ist am ___?","h":"(jung)","a":["jüngsten"],"e":"jung → jünger → am jüngsten."},
    {"t":"g","s":"Das Wetter ist heute ___ als gestern.","h":"(gut)","a":["besser"],"e":"gut → besser."},
    {"t":"r","i":"Compare with 'als'.","s":"Anna ist 30. Tom ist 25. (alt)","a":["Anna ist älter als Tom."],"e":"alt → älter + als."},
    {"t":"r","i":"Compare with 'so … wie'.","s":"Der Rock kostet 50 Franken. Die Hose kostet 50 Franken. (teuer)","a":["Der Rock ist so teuer wie die Hose.","Die Hose ist so teuer wie der Rock."],"e":"Same amount: so ... wie."},
    {"t":"r","i":"Complete the comparison with the superlative ('am …').","s":"Das Auto ist schnell, der Zug ist schneller, und das Flugzeug …","a":["Das Flugzeug ist am schnellsten.","und das Flugzeug ist am schnellsten."],"e":"Superlative: am + -sten."}
  ],
  "subordinate_word_order": [
    {"t":"c","s":"Ich komme nicht, weil ich krank ___.","o":["bin","bin ich","ich bin"],"a":"bin","e":"After weil, the verb goes to the end."},
    {"t":"c","s":"Ich glaube, dass er heute ___.","o":["arbeitet","arbeitet er","er arbeitet"],"a":"arbeitet","e":"dass-clause: verb at the end."},
    {"t":"c","s":"Wenn das Wetter gut ist, ___ wir an den See.","o":["gehen","wir gehen","gehen wir nicht"],"a":"gehen","e":"When the subordinate clause comes first, the main clause starts with the verb."},
    {"t":"c","s":"Sie ist müde, weil sie früh ___.","o":["aufgestanden ist","ist aufgestanden","aufstand ist"],"a":"aufgestanden ist","e":"Perfekt in a subordinate clause: participle, then the auxiliary at the end."},
    {"t":"c","s":"Ich weiß, dass du morgen arbeiten ___.","o":["musst","musst du","du musst"],"a":"musst","e":"The modal verb goes to the very end."},
    {"t":"c","s":"Ruf mich an, wenn du ___.","o":["ankommst","kommst an","an kommst"],"a":"ankommst","e":"In subordinate clauses separable verbs are written together at the end."},
    {"t":"c","s":"___ ich Zeit habe, lese ich.","o":["Wenn","Weil","Dass"],"a":"Wenn","e":"wenn = if/whenever."},
    {"t":"c","s":"Es ist schön, ___ du da bist.","o":["dass","weil","wenn"],"a":"dass","e":"Es ist schön, dass ... (that)."},
    {"t":"g","s":"Ich lerne Deutsch, weil ich in der Schweiz ___.","h":"(wohnen)","a":["wohne"],"e":"Verb at the end."},
    {"t":"g","s":"Er sagt, dass er keine Zeit ___.","h":"(haben)","a":["hat"],"e":"Verb at the end."},
    {"t":"g","s":"Wenn du Hilfe brauchst, ___ mich an!","h":"(anrufen, du-imperative)","a":["ruf","rufe"],"e":"Main clause after the wenn-clause starts with the verb."},
    {"t":"g","s":"Ich bleibe zu Hause, weil ich morgen früh ___ muss.","h":"(aufstehen)","a":["aufstehen"],"e":"Infinitive before the modal at the end."},
    {"t":"g","s":"Weil es regnet, ___ wir den Bus.","h":"(nehmen)","a":["nehmen"],"e":"After the weil-clause: verb first."},
    {"t":"r","i":"Join with 'weil'.","s":"Ich gehe zum Arzt. Ich habe Fieber.","a":["Ich gehe zum Arzt, weil ich Fieber habe."],"e":"weil sends the verb to the end."},
    {"t":"r","i":"Join with 'dass'.","s":"Ich hoffe. Du kommst bald.","a":["Ich hoffe, dass du bald kommst."],"e":"dass-clause: verb at the end."},
    {"t":"r","i":"Start with 'Wenn'.","s":"Ich habe frei. Ich schlafe lange.","a":["Wenn ich frei habe, schlafe ich lange."],"e":"wenn-clause first, then the main clause starts with the verb."},
    {"t":"r","i":"Join with 'weil'.","s":"Sie kann nicht kommen. Sie muss arbeiten.","a":["Sie kann nicht kommen, weil sie arbeiten muss."],"e":"Modal verb at the very end."},
    {"t":"r","i":"Join with 'dass'.","s":"Er hat gesagt. Er ruft heute an.","a":["Er hat gesagt, dass er heute anruft."],"e":"anrufen written together at the end."},
    {"t":"r","i":"Start with 'Weil'.","s":"Ich bin müde, weil ich schlecht geschlafen habe.","a":["Weil ich schlecht geschlafen habe, bin ich müde."],"e":"The main clause now starts with the verb."}
  ],
  "adjective_endings": [
    {"t":"c","s":"Der ___ Kollege heißt Marco.","o":["neue","neuer","neuen"],"a":"neue","e":"After der (nominative): -e."},
    {"t":"c","s":"Das ist ein ___ Film.","o":["guter","gute","guten"],"a":"guter","e":"ein + masculine nominative: -er shows the gender."},
    {"t":"c","s":"Ich trinke gern ___ Tee.","o":["grünen","grüner","grüne"],"a":"grünen","e":"No article, masculine accusative: -en."},
    {"t":"c","s":"Wir wohnen in einer ___ Wohnung.","o":["kleinen","kleine","kleiner"],"a":"kleinen","e":"Dative after einer: -en."},
    {"t":"c","s":"Sie hat ein ___ Auto gekauft.","o":["neues","neue","neuen"],"a":"neues","e":"ein + neuter accusative: -es."},
    {"t":"c","s":"Ich mag ___ Brot.","o":["frisches","frische","frischen"],"a":"frisches","e":"No article, neuter accusative: -es."},
    {"t":"c","s":"Mit dem ___ Zug bin ich schneller.","o":["neuen","neue","neuem"],"a":"neuen","e":"After dem: -en."},
    {"t":"c","s":"Die ___ Schuhe sind sehr bequem.","o":["roten","rote","roter"],"a":"roten","e":"Plural after die: -en."},
    {"t":"g","s":"Ich suche einen ___ Job.","h":"(gut)","a":["guten"],"e":"einen + masculine accusative: -en."},
    {"t":"g","s":"Das ist eine ___ Idee!","h":"(toll)","a":["tolle"],"e":"eine + feminine nominative: -e."},
    {"t":"g","s":"Er wohnt mit seinem ___ Freund zusammen.","h":"(best-)","a":["besten"],"e":"Dative: -en."},
    {"t":"g","s":"___ Wetter heute, oder?","h":"(schön, no article, neuter)","a":["Schönes"],"e":"No article, neuter nominative: -es."},
    {"t":"g","s":"Ich habe keine ___ Freunde in Basel.","h":"(alt)","a":["alten"],"e":"Plural after keine: -en."},
    {"t":"g","s":"Das ___ Kind spielt im Garten.","h":"(klein)","a":["kleine"],"e":"After das (nominative): -e."},
    {"t":"g","s":"Ich trinke ___ Milch.","h":"(kalt, no article)","a":["kalte"],"e":"No article, feminine accusative: -e."},
    {"t":"g","s":"Wir haben ___ Leute kennengelernt.","h":"(nett, no article, plural)","a":["nette"],"e":"No article, plural accusative: -e."},
    {"t":"r","i":"Put the adjective before the noun.","s":"Der Rock ist schwarz. Ich kaufe den Rock.","a":["Ich kaufe den schwarzen Rock."],"e":"den + masculine accusative: -en."},
