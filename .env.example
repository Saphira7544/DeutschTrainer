# Copy to .env and fill in.

# Your OpenAI key (the same one as ExpenseTracker is fine).
OPENAI_API_KEY=

# A long random password the phone app sends with every request.
# Create one: .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(24))"
APP_ACCESS_TOKEN=

# Optional: change the AI models.
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
